---
// Ambient audit ticker. Slow horizontal loop of sample findings, terminal-style.
// Decorative and duplicated so the loop never shows a gap; hidden from AT.
const items = [
  'AI ENGINES THAT RECOMMEND YOU · 1 OF 4',
  'OTA ADS ABOVE YOUR OWN NAME · 2',
  'REVIEW REPLY LAG · 12 DAYS',
  'DIRECT UPSIDE AT CURRENT ADR · +22%',
  'COMP SET · 74 HOTELS · BAND-MATCHED',
  'SCAN TIME · 11.2S',
  'ANSWER PANELS COVERED · 3 OF 12',
  'BRAND SEARCH SHARE · 62%',
  'COMP SET MATCHED BY ADR BAND · KEYS · SEGMENT',
];
---

<div class="flex border-y border-edge bg-paper">
  {/* Pinned system status */}
  <div class="flex items-center gap-2 px-5 py-2.5 border-r border-edge shrink-0">
    <span
      class="inline-block h-2 w-2 rounded-sm bg-good"
      style="animation: hg-pulse 2.4s ease-in-out infinite;"
      aria-hidden="true"
    ></span>
    <span class="meta tabular whitespace-nowrap">SYSTEMS OPERATIONAL · 38 SOURCES</span>
  </div>

  {/* Rolling audit facts */}
  <div class="ticker overflow-hidden flex-1" aria-hidden="true">
    <div class="ticker-track">
      {[0, 1].map(() => (
        <div class="flex shrink-0">
          {items.map((t) => (
            <span class="meta tabular whitespace-nowrap px-7 py-2.5 border-r border-edge">{t}</span>
          ))}
        </div>
      ))}
    </div>
  </div>
</div>
