---
const steps = [
  { num: '01', head: 'We pull',  one: 'Every public signal, without touching your logins or PMS.' },
  { num: '02', head: 'We grade', one: 'Scored against your comp set, with a method we publish.' },
  { num: '03', head: 'You act',  one: 'A ranked list of fixes, each priced by payback.' },
];
---

<section id="how-it-works" class="panel relative overflow-hidden" style="background: #E4F2EE;">
  {/* Abstract wash backing the section (Granola-style) — not a photo. */}
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-32 -right-24 w-[520px] h-[520px] rounded-full"
    style="background: radial-gradient(closest-side, rgba(13,148,136,0.22), transparent 72%); filter: blur(6px);"
  ></div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -bottom-40 -left-32 w-[460px] h-[460px] rounded-full"
    style="background: radial-gradient(closest-side, rgba(91,91,214,0.10), transparent 72%); filter: blur(6px);"
  ></div>

  <div class="max-w-content mx-auto px-8 py-20 relative">
  <div class="mb-10" data-reveal>
    <span class="label block mb-3">Method</span>
    <h2 class="headline text-[38px] sm:text-[50px] max-w-[680px]">
      Three steps, thirty seconds.
    </h2>
  </div>
  <div class="grid grid-cols-1 lg:grid-cols-[1fr_380px] gap-10 lg:gap-16 items-center">

    <div>
      {steps.map((s, i) => (
        <div class={`flex gap-6 sm:gap-8 items-center py-6 ${i > 0 ? 'border-t border-teal/15' : ''}`}>
          <span class="font-serif text-[44px] sm:text-[52px] leading-none text-teal-strong tabular shrink-0">{s.num}</span>
          <div>
            <h3 class="headline text-[22px] sm:text-[24px]">{s.head}</h3>
            <p class="text-[14px] text-ink-60 mt-1.5 leading-relaxed max-w-[440px]">{s.one}</p>
          </div>
        </div>
      ))}
    </div>

    <figure>
      <img
        src="/images/hero-property.jpg"
        alt="Carved stone entrance of an independent hotel"
        loading="lazy"
        class="w-full h-[300px] lg:h-[420px] object-cover border border-teal/15 rounded-sm"
      />
      <figcaption class="meta mt-2">Any property, anywhere</figcaption>
    </figure>

  </div>
  </div>
</section>
