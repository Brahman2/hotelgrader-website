    <nav class="flex flex-wrap gap-x-5 gap-y-1">
      <a href="/methodology" class="text-ink-60 hover:text-accent">methodology</a>
      <a href="/about" class="text-ink-60 hover:text-accent">about</a>
      <a href="/privacy" class="text-ink-60 hover:text-accent">privacy</a>
      <a href="/terms" class="text-ink-60 hover:text-accent">terms</a>
      <a href="mailto:contact@hotelgrader.com" class="text-ink-60 hover:text-accent">contact</a>
    </nav>
    <span class="flex items-center gap-4">
