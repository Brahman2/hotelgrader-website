---
import { pillars } from '../content/pillars';

const gradeClass = (g: string) => {
  const c = (g[0] || '').toUpperCase();
  return c === 'A' ? 'grade--a' : c === 'B' ? 'grade--b' : c === 'C' ? 'grade--c' : c === 'D' ? 'grade--d' : 'grade--f';
};
---

<section id="pillars" class="bg-paper border-y border-edge">
  <div class="max-w-content mx-auto px-8 py-20">
  <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 mb-10">
    <div>
      <span class="label block mb-3">Findings</span>
      <h2 class="headline text-[30px] sm:text-[38px] max-w-[720px]">
        The seven grades, and what each one is <em>costing you.</em>
      </h2>
      <p class="text-[14px] text-ink-60 mt-3 max-w-[560px] leading-relaxed">
        Every grade comes with a prioritized fix queue: what to change, in what
        order, and what each fix is worth in direct bookings.
      </p>
    </div>
    <span class="meta tabular whitespace-nowrap">Sample, The Riverton, comp set of 74</span>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-[360px_1fr] gap-10 lg:gap-16 items-stretch">

    <figure class="hidden lg:flex flex-col">
      <img
        src="/images/courtyard.jpg"
        alt="Sunlit courtyard and stone staircase of a boutique hotel"
        loading="lazy"
        class="w-full flex-1 object-cover border-2 border-ink rounded-sm min-h-[480px] photo-warm"
      />
      <figcaption class="meta mt-2">Seven sections, one letter</figcaption>
    </figure>

    <div>
      {pillars.map((p, i) => (
        <a
          href={`/methodology#s-${p.num}`}
          class={`grid grid-cols-[44px_1fr_auto] items-center gap-4 sm:gap-6 py-[18px] px-3 -mx-3 rounded-sm transition-colors duration-150 hover:bg-paper text-ink ${i > 0 ? 'border-t border-edge' : ''}`}
          style="border-bottom: 0;"
        >
          <span class="meta tabular">{p.num}</span>
          <div>
            <h3 class="text-[16px] sm:text-[17px] font-semibold tracking-tight">{p.name}</h3>
            <p class="text-[13px] text-ink-60 mt-1 leading-snug">{p.punch}</p>
          </div>
          <div class="text-right">
            <span class={`grade tabular text-[44px] sm:text-[52px] leading-none ${gradeClass(p.sample.grade)}`}>
              {p.sample.grade}
            </span>
            <div class={`meta tabular mt-1 ${p.sample.delta.startsWith('+') || p.sample.delta.startsWith('Top') ? 'text-good' : p.sample.delta.startsWith('−') || p.sample.delta.startsWith('Bottom') ? 'text-attention' : ''}`}>
              {p.sample.delta}
            </div>
          </div>
        </a>
      ))}
      <p class="meta tabular pt-4 border-t border-edge">
        46 metrics, weighted by booking impact.
        <a href="/methodology" class="text-indigo hover:underline" style="border-bottom: 0;">Full methodology →</a>
      </p>
    </div>

  </div>
</section>
