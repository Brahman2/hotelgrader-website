---
// Flips between the light theme (default) and the dark terminal theme.
// The click handler and the saved choice live in BaseLayout.
---

<button type="button" class="theme-toggle no-print" data-theme-toggle aria-label="Switch between light and dark theme">
  <span class="light-only">&gt;_ dark</span>
  <span class="dark-only">☀ light</span>
</button>
