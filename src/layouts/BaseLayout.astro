---
import '@fontsource-variable/schibsted-grotesk';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  showHeader?: boolean;
  showFooter?: boolean;
  /** Keep per-hotel result pages out of search indexes */
  noindex?: boolean;
}

const {
  title = 'hotelgrader: grade any hotel’s marketing',
  description = 'Type a hotel and get a free report card: one grade, how it ranks against the hotels nearby, and what to fix first. Takes two minutes.',
  showHeader = true,
  showFooter = true,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);

// Google Analytics 4 (property "hotelgrader.com"). Production builds only.
const GA_ID = import.meta.env.PROD ? 'G-3G3TFQZW00' : '';
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="xQxgR4UKeUiIhuK1UWLVhI65OHNo5-I1JGDNsHu9nR4" />
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0B0D0C" />
    <script is:inline>
      // Dark is the default (set on <html>). Apply a saved light choice before first paint.
      try { if (localStorage.getItem('hg-theme') === 'light') delete document.documentElement.dataset.theme; } catch (e) {}
    </script>
    {GA_ID && (
      <script is:inline define:vars={{ GA_ID }}>
        // Skipped for the team's tester browsers (?test=on) so our own runs stay out of the numbers.
        (function () {
          try {
            if (new URLSearchParams(location.search).get('test')) return;
            var u = JSON.parse(localStorage.getItem('hg-user') || 'null');
            if (u && u.proof === 'tester') return;
          } catch (e) {}
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
          document.head.appendChild(s);
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { dataLayer.push(arguments); };
          gtag('js', new Date());
          // A shared report link carries a key (?k=) that opens the report. Keep it out of analytics.
          var url = new URL(location.href);
          url.searchParams.delete('k');
          gtag('config', GA_ID, { page_location: url.toString() });
        })();
      </script>
    )}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://hotelgrader.com/og.png?v=4" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="hotelgrader. Grade any hotel’s marketing. Yours, or the one down the street. Free, takes two minutes. A sample grade of B+ sits beside the text." />
    <meta property="og:site_name" content="hotelgrader" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://hotelgrader.com/og.png?v=4" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'Organization',
          '@id': 'https://hotelgrader.com/#org',
          name: 'hotelgrader',
          url: 'https://hotelgrader.com',
          logo: 'https://hotelgrader.com/assets/favicon.svg',
          description: 'A free report card for any hotel’s marketing, graded from public data and weighted by what matters to bookings.',
          contactPoint: { '@type': 'ContactPoint', email: 'contact@hotelgrader.com', contactType: 'customer support' },
        },
        {
          '@type': 'WebSite',
          '@id': 'https://hotelgrader.com/#site',
          name: 'hotelgrader',
          url: 'https://hotelgrader.com',
          publisher: { '@id': 'https://hotelgrader.com/#org' },
        },
      ],
    })} />
  </head>
  <body class="text-ink font-sans antialiased">
    {showHeader && <Header />}
    <main>
      <slot />
    </main>
    {showFooter && <Footer />}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var meta = document.querySelector('meta[name="theme-color"]');
        var icon = document.querySelector('link[rel="icon"][type="image/svg+xml"]');
        function sync() {
          var dark = root.dataset.theme === 'dark';
          if (meta) meta.content = dark ? '#0B0D0C' : '#F5F5F7';
          // The logo mark in light, the terminal mark in dark.
          if (icon) icon.href = dark ? '/assets/favicon-terminal.svg' : '/assets/favicon.svg';
        }
        sync();
        document.addEventListener('click', function (e) {
          if (!e.target.closest || !e.target.closest('[data-theme-toggle]')) return;
          var dark = root.dataset.theme !== 'dark';
          if (dark) root.dataset.theme = 'dark'; else delete root.dataset.theme;
          try { localStorage.setItem('hg-theme', dark ? 'dark' : 'light'); } catch (err) {}
          sync();
        });
      })();
    </script>
    <script is:inline>
      // Tester switch for the team. Opening any page with ?test=on unlocks both
      // email gate in this browser and records no lead;
      // ?test=off locks them again. There is no secret code: the gates are a
      // lead-capture step, not security, so this protects nothing sensitive.
      (function () {
        var q = new URLSearchParams(location.search);
        var mode = q.get('test');
        if (mode !== 'on' && mode !== 'off') return;
        q.delete('test');
        var rest = q.toString();
        var clean = location.pathname + (rest ? '?' + rest : '') + location.hash;
        try {
          if (mode === 'on') {
            localStorage.setItem('hg-user', JSON.stringify({ name: 'Tester', email: 'tester@hotelgrader.com', proof: 'tester' }));
            localStorage.setItem('hg-shared', '1');
          } else {
            localStorage.removeItem('hg-user');
            localStorage.removeItem('hg-shared');
          }
        } catch (e) {}
        location.replace(clean);
      })();
    </script>
  </body>
</html>
