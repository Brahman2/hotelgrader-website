---
import { HG_APP } from '../lib/hg';

interface Props {
  showCta?: boolean;
}
const { showCta = true } = Astro.props;
const loginUrl = `${HG_APP}/login`;
---

<header class="flex items-center justify-between px-8 py-[18px] border-b border-edge bg-bone">
  <a
    href="/"
    class="flex items-center gap-2.5 text-[22px] font-semibold tracking-[-0.04em] text-ink"
    style="border-bottom: 0;"
  >
    <img src="/assets/favicon.svg" alt="" class="h-[26px] w-[26px]" />
    <span>hotelgrader</span>
  </a>
  <nav class="hidden md:flex items-center gap-6">
    <a href="/#pillars" class="text-sm text-ink hover:text-indigo transition-colors duration-150">What we analyze</a>
    <a href="/methodology" class="text-sm text-ink hover:text-indigo transition-colors duration-150">Methodology</a>
    <a href="/pricing" class="text-sm text-ink hover:text-indigo transition-colors duration-150">Pricing</a>
    <a href="/#faq" class="text-sm text-ink hover:text-indigo transition-colors duration-150">FAQ</a>
    <a href={loginUrl} class="text-sm text-ink hover:text-indigo transition-colors duration-150">Log in</a>
    {showCta && (
      <a href="/#get-the-report" class="btn border-edge-strong">
        <span>Get my free report</span>
        <span data-arrow aria-hidden="true">→</span>
      </a>
    )}
  </nav>
  <nav class="md:hidden flex items-center gap-2">
    {showCta && (
      <a href="/#get-the-report" class="btn text-[13px] px-3 py-2">Get my free report</a>
    )}
    <details class="relative">
      <summary class="btn text-[13px] px-3 py-2 list-none cursor-pointer select-none">Menu</summary>
      <div class="absolute right-0 top-full mt-2 w-[220px] border border-edge rounded bg-bone z-30 overflow-hidden">
        <a href="/#pillars" class="block px-4 py-3 text-sm text-ink hover:bg-paper transition-colors duration-150" style="border-bottom: 0;">What we analyze</a>
        <a href="/methodology" class="block px-4 py-3 text-sm text-ink border-t border-edge hover:bg-paper transition-colors duration-150" style="border-bottom: 0;">Methodology</a>
        <a href="/pricing" class="block px-4 py-3 text-sm text-ink border-t border-edge hover:bg-paper transition-colors duration-150" style="border-bottom: 0;">Pricing</a>
        <a href="/about" class="block px-4 py-3 text-sm text-ink border-t border-edge hover:bg-paper transition-colors duration-150" style="border-bottom: 0;">About</a>
        <a href="/#faq" class="block px-4 py-3 text-sm text-ink border-t border-edge hover:bg-paper transition-colors duration-150" style="border-bottom: 0;">FAQ</a>
        <a href={loginUrl} class="block px-4 py-3 text-sm text-ink border-t border-edge hover:bg-paper transition-colors duration-150" style="border-bottom: 0;">Log in</a>
      </div>
    </details>
  </nav>
</header>
