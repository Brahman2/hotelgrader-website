---
// Trust strip: the platforms whose public data feeds the grade, set as quiet
// typographic marks (the grayscale logo-bar convention, done in type).
const sources = ['Google', 'Tripadvisor', 'Booking.com', 'Expedia', 'ChatGPT', 'Instagram'];
---

<div class="mt-10 text-center">
  <span class="meta tabular block mb-3">Reads public data from</span>
  <div class="flex flex-wrap items-baseline justify-center gap-x-8 gap-y-2">
    {sources.map((s) => (
      <span class="font-display font-semibold text-[16px] sm:text-[17px] tracking-tight text-ink-40 select-none">{s}</span>
    ))}
  </div>
</div>
