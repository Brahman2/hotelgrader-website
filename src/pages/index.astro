---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Pillars from '../components/Pillars.astro';
import EvidenceTabs from '../components/EvidenceTabs.tsx';
import HeroForm from '../components/HeroForm.tsx';
import SocialProof from '../components/SocialProof.astro';
import Product from '../components/Product.astro';
import FAQ from '../components/FAQ.astro';
import FinalCTA from '../components/FinalCTA.astro';
---

<BaseLayout>
  <Hero />
  <HowItWorks />
  <Pillars />

  {/* Full-bleed property band — warm establishing imagery (Unsplash, see CREDITS) */}
  <section class="relative" data-reveal>
    <img
      src="/images/lobby-warm.jpg"
      alt="Sunlit guest room in an independent boutique hotel"
      loading="lazy"
      class="w-full h-[280px] sm:h-[400px] lg:h-[500px] object-cover"
    />
  </section>

  <section id="evidence" class="panel" style="background: #EDEDFB;">
    <div class="max-w-content mx-auto px-8 py-20">
      <div class="mb-8" data-reveal>
        <span class="label block mb-3">Evidence</span>
        <h2 class="headline text-[38px] sm:text-[50px] max-w-[680px]">
          See the evidence behind <em>every grade.</em>
        </h2>
      </div>
      <div data-reveal="100">
        <EvidenceTabs client:visible />
      </div>
    </div>
  </section>

  {/* Mid-page conversion band — the one iris moment mid-page */}
  <div class="panel" style="background: #5B5BD6;">
    <div class="max-w-content mx-auto px-8 py-12 grid grid-cols-1 lg:grid-cols-[1fr_minmax(0,560px)] gap-6 lg:gap-14 items-center">
      <p class="headline text-[26px] sm:text-[30px]" style="color: #fff;">
        Your grade, your comp-set rank, <em>your upside.</em>
      </p>
      <div class="-mt-6">
        <HeroForm client:visible inputId="mid-hotel" align="left" tone="dark" />
      </div>
    </div>
  </div>

  <SocialProof />
  <Product />
  <FAQ />
  <FinalCTA />
</BaseLayout>
