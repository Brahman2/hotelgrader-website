---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  showHeader?: boolean;
  showFooter?: boolean;
}

const {
  title = 'hotelgrader · independent performance grading for independent hotels',
  description = "A 46-metric audit of your property's digital presence, scored across seven categories, delivered in thirty seconds. Free. No credit card.",
  showHeader = true,
  showFooter = true,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="xQxgR4UKeUiIhuK1UWLVhI65OHNo5-I1JGDNsHu9nR4" />
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://hotelgrader.com/og.png" />
    <meta property="og:site_name" content="hotelgrader" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://hotelgrader.com/og.png" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'Organization',
          '@id': 'https://hotelgrader.com/#org',
          name: 'hotelgrader',
          url: 'https://hotelgrader.com',
          logo: 'https://hotelgrader.com/assets/favicon.svg',
          description: 'The independent grade for hotel marketing. 46 metrics, 38 public sources, seven weighted sections.',
          contactPoint: { '@type': 'ContactPoint', email: 'contact@hotelgrader.com', contactType: 'customer support' },
        },
        {
          '@type': 'WebSite',
          '@id': 'https://hotelgrader.com/#site',
          name: 'hotelgrader',
          url: 'https://hotelgrader.com',
          publisher: { '@id': 'https://hotelgrader.com/#org' },
        },
      ],
    })} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class="bg-paper text-ink font-sans antialiased">
    {showHeader && <Header />}
    <main>
      <slot />
    </main>
    {showFooter && <Footer />}
    <script is:inline>
      // Scroll reveal: [data-reveal] elements rise + fade in on entry.
      // data-reveal="120" adds a 120ms stagger. Honors reduced-motion.
      (function () {
        var els = document.querySelectorAll('[data-reveal]');
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
            !('IntersectionObserver' in window)) {
          els.forEach(function (el) { el.classList.add('is-in'); });
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            var el = entry.target;
            var d = el.getAttribute('data-reveal');
            if (d) el.style.transitionDelay = d + 'ms';
            el.classList.add('is-in');
            io.unobserve(el);
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
        els.forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>
