# Live hotelgrader backend (Railway). Same API the production app calls.
PUBLIC_HG_API=https://web-production-13e22.up.railway.app

# Where the live audit runner (React app) lives. For the split-domain setup,
# the app moves to app.hotelgrader.com and this points there, so the hero
# search and every "get my report" CTA hands off to the working app.
# Set the SAME value in Netlify environment variables (Site settings, Build
# and deploy, Environment).
PUBLIC_HG_APP=https://app.hotelgrader.com
