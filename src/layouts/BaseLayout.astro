---
import '@fontsource-variable/schibsted-grotesk';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  showHeader?: boolean;
  showFooter?: boolean;
  /** Keep per-hotel result pages out of search indexes */
  noindex?: boolean;
}

const {
  title = 'hotelgrader · a free report card for any hotel',
  description = "A free report card for your hotel's marketing, scored across seven sections from public data, delivered in a minute or two. Free.",
  showHeader = true,
  showFooter = true,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="xQxgR4UKeUiIhuK1UWLVhI65OHNo5-I1JGDNsHu9nR4" />
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#F5F5F7" />
    <script is:inline>
      // Light is the default. Apply a saved dark choice before first paint.
      try { if (localStorage.getItem('hg-theme') === 'dark') document.documentElement.dataset.theme = 'dark'; } catch (e) {}
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://hotelgrader.com/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="hotelgrader: your hotel has a grade. A stamped B+ beside the headline." />
    <meta property="og:site_name" content="hotelgrader" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://hotelgrader.com/og.png" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'Organization',
          '@id': 'https://hotelgrader.com/#org',
          name: 'hotelgrader',
          url: 'https://hotelgrader.com',
          logo: 'https://hotelgrader.com/assets/favicon.svg',
          description: 'The independent grade for hotel marketing. 43 metrics, 38 public sources, seven weighted sections.',
          contactPoint: { '@type': 'ContactPoint', email: 'contact@hotelgrader.com', contactType: 'customer support' },
        },
        {
          '@type': 'WebSite',
          '@id': 'https://hotelgrader.com/#site',
          name: 'hotelgrader',
          url: 'https://hotelgrader.com',
          publisher: { '@id': 'https://hotelgrader.com/#org' },
        },
      ],
    })} />
  </head>
  <body class="text-ink font-sans antialiased">
    {showHeader && <Header />}
    <main>
      <slot />
    </main>
    {showFooter && <Footer />}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var meta = document.querySelector('meta[name="theme-color"]');
        var icon = document.querySelector('link[rel="icon"][type="image/svg+xml"]');
        function sync() {
          var dark = root.dataset.theme === 'dark';
          if (meta) meta.content = dark ? '#0B0D0C' : '#F5F5F7';
          // The logo mark in light, the terminal mark in dark.
          if (icon) icon.href = dark ? '/assets/favicon-terminal.svg' : '/assets/favicon.svg';
        }
        sync();
        document.addEventListener('click', function (e) {
          if (!e.target.closest || !e.target.closest('[data-theme-toggle]')) return;
          var dark = root.dataset.theme !== 'dark';
          if (dark) root.dataset.theme = 'dark'; else delete root.dataset.theme;
          try { localStorage.setItem('hg-theme', dark ? 'dark' : 'light'); } catch (err) {}
          sync();
        });
      })();
    </script>
  </body>
</html>
