---
import HeroForm from './HeroForm.tsx';
---

<section style="background: #F3EBDA;">
  <div class="max-w-content mx-auto px-8 py-16 sm:py-20 text-center">
    <span class="label block mb-5" data-reveal>START YOUR AUDIT</span>
    <h2
      class="headline text-[40px] sm:text-[56px] max-w-[820px] mx-auto"
      style="text-wrap: balance;"
      data-reveal="60"
    >
      Your comp set <em>already ran this.</em>
    </h2>
    <HeroForm client:load inputId="final-domain" />
    <p class="meta tabular mt-3">FREE FOREVER · NO CREDIT CARD · 30-SECOND ANALYSIS</p>
  </div>
</section>
