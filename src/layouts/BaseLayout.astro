---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  showHeader?: boolean;
  showFooter?: boolean;
}

const {
  title = 'hotelgrader · independent performance grading for independent hotels',
  description = "A 46-metric audit of your property's digital presence, scored across seven categories, delivered in thirty seconds. Free. No credit card.",
  showHeader = true,
  showFooter = true,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="xQxgR4UKeUiIhuK1UWLVhI65OHNo5-I1JGDNsHu9nR4" />
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#FCFBF7" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://hotelgrader.com/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="hotelgrader — your hotel has a grade. A stamped B+ beside the headline." />
    <meta property="og:site_name" content="hotelgrader" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://hotelgrader.com/og.png" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'Organization',
          '@id': 'https://hotelgrader.com/#org',
          name: 'hotelgrader',
          url: 'https://hotelgrader.com',
          logo: 'https://hotelgrader.com/assets/favicon.svg',
          description: 'The independent grade for hotel marketing. 46 metrics, 38 public sources, seven weighted sections.',
          contactPoint: { '@type': 'ContactPoint', email: 'contact@hotelgrader.com', contactType: 'customer support' },
        },
        {
          '@type': 'WebSite',
          '@id': 'https://hotelgrader.com/#site',
          name: 'hotelgrader',
          url: 'https://hotelgrader.com',
          publisher: { '@id': 'https://hotelgrader.com/#org' },
        },
      ],
    })} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class="bg-paper text-ink font-sans antialiased">
    {showHeader && <Header />}
    <main>
      <slot />
    </main>
    {showFooter && <Footer />}
    <script is:inline>
      // Motion controller. All effects honor prefers-reduced-motion.
      //  - [data-reveal]  : rise + fade on entry (data-reveal="120" staggers)
      //  - [data-stamp]   : grade "stamps" in (scale) on entry
      //  - [data-countup] : number counts from 0 to its value on entry
      //  - [data-parallax]: background drifts on scroll for depth
      (function () {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var hasIO = 'IntersectionObserver' in window;

        // Reveal + stamp
        var revealEls = document.querySelectorAll('[data-reveal], [data-stamp]');
        if (reduce || !hasIO) {
          revealEls.forEach(function (el) { el.classList.add('is-in'); });
        } else {
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              var el = entry.target;
              var d = el.getAttribute('data-reveal') || el.getAttribute('data-stamp');
              if (d) el.style.transitionDelay = d + 'ms';
              el.classList.add('is-in');
              io.unobserve(el);
            });
          }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
          revealEls.forEach(function (el) { io.observe(el); });
        }

        // Count-up
        if (!reduce && hasIO) {
          document.querySelectorAll('[data-countup]').forEach(function (el) {
            var finalText = el.textContent.trim();
            var m = finalText.match(/^(\D*)(\d[\d,]*)(.*)$/);
            if (!m) return;
            var pre = m[1], num = parseInt(m[2].replace(/,/g, ''), 10), post = m[3];
            var cio = new IntersectionObserver(function (entries) {
              entries.forEach(function (e) {
                if (!e.isIntersecting) return;
                cio.disconnect();
                var start = null;
                function tick(t) {
                  if (start === null) start = t;
                  var p = Math.min((t - start) / 900, 1);
                  var eased = 1 - Math.pow(1 - p, 3);
                  el.textContent = pre + Math.round(eased * num) + post;
                  if (p < 1) requestAnimationFrame(tick); else el.textContent = finalText;
                }
                requestAnimationFrame(tick);
              });
            }, { threshold: 0.6 });
            cio.observe(el);
          });
        }

        // Parallax — shift background-position on scroll (subtle depth, no layout shift)
        if (!reduce) {
          var pxEls = [].slice.call(document.querySelectorAll('[data-parallax]'));
          if (pxEls.length) {
            var ticking = false;
            var updatePx = function () {
              var vh = window.innerHeight;
              for (var i = 0; i < pxEls.length; i++) {
                var el = pxEls[i], r = el.getBoundingClientRect();
                if (r.bottom < -80 || r.top > vh + 80) continue;
                var progress = ((r.top + r.height / 2) - vh / 2) / vh;
                var f = parseFloat(el.getAttribute('data-parallax')) || 16;
                el.style.backgroundPosition = '50% ' + (50 + progress * f).toFixed(1) + '%';
              }
              ticking = false;
            };
            var onScroll = function () { if (!ticking) { ticking = true; requestAnimationFrame(updatePx); } };
            window.addEventListener('scroll', onScroll, { passive: true });
            window.addEventListener('resize', onScroll, { passive: true });
            updatePx();
          }
        }
      })();
    </script>
  </body>
</html>
