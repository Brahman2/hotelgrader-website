---
import DashboardTour from './DashboardTour.tsx';
---

<section id="product" class="max-w-content mx-auto px-8 py-16">
  <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 mb-8" data-reveal>
    <div>
      <span class="label block mb-3">THE DASHBOARD</span>
      <h2 class="headline text-[30px] sm:text-[38px] max-w-[720px]">
        Where the grade turns into <em>bookings.</em>
      </h2>
      <p class="text-[14px] text-ink-60 mt-3 max-w-[560px] leading-relaxed">
        Pro re-scans on demand, ranks every fix by payback, watches your
        competitors, and answers questions with your own data.
      </p>
    </div>
    <a href="/pricing" class="meta tabular text-indigo hover:underline whitespace-nowrap" style="border-bottom: 0;">
      PRICING →
    </a>
  </div>

  <div data-reveal="80">
    <DashboardTour client:visible />
  </div>
</section>
