---
const steps = [
  { num: '01', head: 'We pull',  one: 'Every public signal. AI engines, search, reviews, ads, booking flow. No logins, no PMS.' },
  { num: '02', head: 'We grade', one: 'Weighted against your comp set. Methodology published, reproducible.' },
  { num: '03', head: 'You act',  one: 'A prioritized queue and one number: what fixing it is worth.' },
];
---

<section id="how-it-works" class="panel" style="background: #FBF0DB;">
  <div class="max-w-content mx-auto px-8 py-20">
  <div class="grid grid-cols-1 lg:grid-cols-[1fr_380px] gap-10 lg:gap-16 items-center">

    <div>
      <span class="label block mb-8">Method</span>
      {steps.map((s, i) => (
        <div class={`flex gap-6 sm:gap-8 items-baseline py-6 ${i > 0 ? 'border-t border-edge' : ''}`}>
          <span class="font-serif text-[44px] sm:text-[52px] leading-none text-sun tabular shrink-0">{s.num}</span>
          <div>
            <h3 class="headline text-[22px] sm:text-[24px]">{s.head}</h3>
            <p class="text-[14px] text-ink-60 mt-1.5 leading-relaxed max-w-[440px]">{s.one}</p>
          </div>
        </div>
      ))}
    </div>

    <figure>
      <img
        src="/images/hero-property.jpg"
        alt="Carved stone entrance of an independent hotel"
        loading="lazy"
        class="w-full h-[300px] lg:h-[420px] object-cover border border-edge rounded-sm"
      />
      <figcaption class="meta mt-2">Any property, anywhere</figcaption>
    </figure>

  </div>
  </div>
</section>
