---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Pillars from '../components/Pillars.astro';
import EvidenceTabs from '../components/EvidenceTabs.tsx';
import HeroForm from '../components/HeroForm.tsx';
import SocialProof from '../components/SocialProof.astro';
import Product from '../components/Product.astro';
import FAQ from '../components/FAQ.astro';
import FinalCTA from '../components/FinalCTA.astro';
---

<BaseLayout>
  <Hero />
  <HowItWorks />
  <Pillars />

  <section id="evidence" class="panel" style="background: #EDEDFB;">
    <div class="max-w-content mx-auto px-8 py-20">
      <div class="mb-8" data-reveal>
        <span class="label block mb-3">Evidence</span>
        <h2 class="headline text-[38px] sm:text-[50px] max-w-[680px]">
          See the proof behind <em>every grade.</em>
        </h2>
      </div>
      <div data-reveal="100">
        <EvidenceTabs client:visible />
      </div>
    </div>
  </section>

  {/* Mid-page conversion band — living waves under the iris moment */}
  <div class="relative isolate overflow-hidden" style="background: #4A47C9;">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 art-pan"
      style="background-image: url('/images/abstract-waves.svg'); background-size: 160% auto; background-position: 0% 42%; z-index: 0;"
    ></div>
    <div aria-hidden="true" class="pointer-events-none absolute inset-0" style="background: rgba(38, 34, 80, 0.38); z-index: 1;"></div>
    <div class="relative z-10 max-w-content mx-auto px-8 py-12 grid grid-cols-1 lg:grid-cols-[1fr_minmax(0,560px)] gap-6 lg:gap-14 items-center">
      <p class="headline text-[26px] sm:text-[30px]" style="color: #fff;">
        Your grade, your rank, and <em>your upside.</em>
      </p>
      <div class="-mt-6">
        <HeroForm client:visible inputId="mid-hotel" align="left" tone="dark" />
      </div>
    </div>
  </div>

  <SocialProof />
  <Product />
  <FAQ />
  <FinalCTA />
</BaseLayout>
