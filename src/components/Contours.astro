---
// The homepage backdrop: a contour map, like the terrain lines on a survey
// chart. The ground rises under the cursor and the lines flow around it, with
// the nearest ones picking up the accent colour. It is drawn from scratch on a
// canvas (smooth noise for the terrain, marching squares for the lines) and
// only animates while the pointer is moving. Touch and reduced-motion visitors
// get the still map.
---

<canvas id="contours" class="contours" aria-hidden="true"></canvas>

<style is:global>
  .contours {
    position: absolute; top: 0; left: 0; width: 100%; height: 100dvh;
    pointer-events: none;
    /* Keep the lines quiet behind the name and the search box. */
    -webkit-mask-image: radial-gradient(ellipse 46% 40% at 50% 40%, rgba(0, 0, 0, 0.12) 40%, #000 100%);
    mask-image: radial-gradient(ellipse 46% 40% at 50% 40%, rgba(0, 0, 0, 0.12) 40%, #000 100%);
  }
  @media print { .contours { display: none; } }
</style>

<script is:inline>
  (function () {
    var canvas = document.getElementById('contours');
    if (!canvas || !canvas.getContext) return;
    var ctx = canvas.getContext('2d');
    var root = document.documentElement;
    var still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    var CELL = 16;          // grid spacing in px
    var HILL = 170;         // radius of the rise under the cursor
    var LEVELS = 20;        // contour lines between 0 and LEVELS * STEP
    var STEP = 0.075;

    var W = 0, H = 0, cols = 0, rows = 0, field = new Float32Array(0);
    var px = 0, py = 0, tx = 0, ty = 0;   // eased and target pointer position
    var lift = 0, liftTo = 0;             // eased and target height of the rise
    var drift = 0, frame = 0, seen = false;
    var ink = '#14151A', accent = '#5B5BD6', dark = false;

    // Smooth value noise: a repeatable pseudo-random height for any point.
    function hash(x, y) { var n = Math.sin(x * 127.1 + y * 311.7) * 43758.5453; return n - Math.floor(n); }
    function noise(x, y) {
      var xi = Math.floor(x), yi = Math.floor(y), xf = x - xi, yf = y - yi;
      var u = xf * xf * (3 - 2 * xf), v = yf * yf * (3 - 2 * yf);
      var a = hash(xi, yi), b = hash(xi + 1, yi), c = hash(xi, yi + 1), d = hash(xi + 1, yi + 1);
      return a + (b - a) * u + (c - a) * v + (a - b - c + d) * u * v;
    }

    function colours() {
      var cs = getComputedStyle(root);
      dark = root.dataset.theme === 'dark';
      ink = cs.getPropertyValue('--ink').trim() || ink;
      accent = cs.getPropertyValue('--accent').trim() || accent;
    }

    function resize() {
      var dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = canvas.clientWidth; H = canvas.clientHeight;
      canvas.width = Math.round(W * dpr); canvas.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      cols = Math.ceil(W / CELL) + 1; rows = Math.ceil(H / CELL) + 1;
      field = new Float32Array(cols * rows);
      draw();
    }

    function heights() {
      var k = 1 / (2 * HILL * HILL);
      for (var j = 0; j < rows; j++) {
        var y = j * CELL;
        for (var i = 0; i < cols; i++) {
          var x = i * CELL;
          var h = 0.62 * noise(x / 300 + drift, y / 300 + 3.1) + 0.38 * noise(x / 120 - drift * 0.6, y / 120 + 9.7);
          if (lift > 0.002) { var dx = x - px, dy = y - py; h += lift * 0.6 * Math.exp(-(dx * dx + dy * dy) * k); }
          field[j * cols + i] = h;
        }
      }
    }

    // Marching squares: for each grid cell and each height, find where that
    // height crosses the cell's edges and join the crossings with a line.
    function trace() {
      var path = new Path2D();
      for (var j = 0; j < rows - 1; j++) {
        for (var i = 0; i < cols - 1; i++) {
          var a = field[j * cols + i], b = field[j * cols + i + 1];
          var c = field[(j + 1) * cols + i + 1], d = field[(j + 1) * cols + i];
          var lo = Math.min(a, b, c, d), hi = Math.max(a, b, c, d);
          var x = i * CELL, y = j * CELL;
          for (var n = Math.max(1, Math.ceil(lo / STEP)); n <= LEVELS && n * STEP < hi; n++) {
            var L = n * STEP;
            var code = (a > L ? 8 : 0) | (b > L ? 4 : 0) | (c > L ? 2 : 0) | (d > L ? 1 : 0);
            if (code === 0 || code === 15) continue;
            var topX = x + CELL * (L - a) / (b - a), rightY = y + CELL * (L - b) / (c - b);
            var botX = x + CELL * (L - d) / (c - d), leftY = y + CELL * (L - a) / (d - a);
            var r = x + CELL, btm = y + CELL;
            switch (code) {
              case 1: case 14: path.moveTo(x, leftY); path.lineTo(botX, btm); break;
              case 2: case 13: path.moveTo(botX, btm); path.lineTo(r, rightY); break;
              case 3: case 12: path.moveTo(x, leftY); path.lineTo(r, rightY); break;
              case 4: case 11: path.moveTo(topX, y); path.lineTo(r, rightY); break;
              case 6: case 9: path.moveTo(topX, y); path.lineTo(botX, btm); break;
              case 7: case 8: path.moveTo(topX, y); path.lineTo(x, leftY); break;
              case 5: path.moveTo(topX, y); path.lineTo(r, rightY); path.moveTo(x, leftY); path.lineTo(botX, btm); break;
              case 10: path.moveTo(topX, y); path.lineTo(x, leftY); path.moveTo(botX, btm); path.lineTo(r, rightY); break;
            }
          }
        }
      }
      return path;
    }

    function draw() {
      if (!W || !H) return;
      heights();
      var path = trace();
      ctx.clearRect(0, 0, W, H);
      ctx.lineWidth = 1;
      ctx.globalAlpha = dark ? 0.17 : 0.13;
      ctx.strokeStyle = ink;
      ctx.stroke(path);
      if (lift > 0.01) {
        // Re-stroke the same lines in the accent colour, fading out from the cursor.
        var glow = ctx.createRadialGradient(px, py, 0, px, py, HILL * 1.7);
        glow.addColorStop(0, accent);
        glow.addColorStop(1, accent + '00');
        ctx.globalAlpha = Math.min(1, lift) * (dark ? 0.9 : 0.8);
        ctx.strokeStyle = glow;
        ctx.stroke(path);
      }
      ctx.globalAlpha = 1;
    }

    function tick() {
      frame = 0;
      px += (tx - px) * 0.14; py += (ty - py) * 0.14;
      lift += (liftTo - lift) * 0.09;
      drift += 0.0009;
      draw();
      var settled = Math.abs(tx - px) < 0.4 && Math.abs(ty - py) < 0.4 && Math.abs(liftTo - lift) < 0.004;
      if (!settled) frame = requestAnimationFrame(tick);
    }
    function wake() { if (!frame) frame = requestAnimationFrame(tick); }

    colours();
    resize();
    window.addEventListener('resize', resize);
    new MutationObserver(function () { colours(); draw(); }).observe(root, { attributes: true, attributeFilter: ['data-theme'] });

    if (still) return;
    window.addEventListener('pointermove', function (e) {
      if (e.pointerType !== 'mouse') return;
      var box = canvas.getBoundingClientRect();
      tx = e.clientX - box.left; ty = e.clientY - box.top;
      if (!seen) { seen = true; px = tx; py = ty; }
      liftTo = 1;
      wake();
    }, { passive: true });
    document.addEventListener('mouseleave', function () { liftTo = 0; wake(); });
  })();
</script>
