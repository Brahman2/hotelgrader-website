---
import ThemeToggle from './ThemeToggle.astro';
// Slim bar for every page except the homepage, which is just the search box.
---

<header class="border-b border-edge">
  <div class="max-w-content mx-auto flex items-center justify-between px-5 sm:px-8 h-[56px]">
    <a href="/" class="text-ink font-semibold tracking-tight text-[15px] hover:no-underline whitespace-nowrap">
      <img src="/assets/favicon.svg" alt="" width="24" height="24" class="light-only inline-block align-[-6px] mr-2 rounded-[6px]" />hotelgrader<span class="text-accent dark-only">_</span>
      <span class="chip ml-2">beta</span>
    </a>
    <nav class="flex items-center gap-5 text-[13px]">
      <a href="/methodology" class="text-ink-60 hover:text-accent hidden sm:inline">methodology</a>
      <a href="/about" class="text-ink-60 hover:text-accent hidden sm:inline">about</a>
      <a href="/" class="text-accent whitespace-nowrap">grade a hotel →</a>
      <span class="hidden sm:inline"><ThemeToggle /></span>
    </nav>
  </div>
</header>
