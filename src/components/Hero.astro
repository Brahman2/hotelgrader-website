---
import HeroForm from './HeroForm.tsx';
import HeroDemo from './HeroDemo.tsx';
import SourcesStrip from './SourcesStrip.astro';
---

<section class="px-6 sm:px-8 pt-16 sm:pt-24 pb-12 max-w-content mx-auto text-center">
  <h1 class="headline text-[46px] sm:text-[66px] lg:text-[80px] max-w-[16ch] mx-auto" style="text-wrap: balance;">
    Your hotel has a grade. <em>You just haven’t seen it.</em>
  </h1>
  <p class="text-[17px] sm:text-[19px] text-ink-60 leading-relaxed max-w-[520px] mx-auto mt-5">
    A 46-metric read on how guests find you, scored against your comp set in thirty seconds.
  </p>

  <HeroForm client:load align="center" />
  <p class="text-[12px] text-ink-40 mt-3 tabular">
    Free, no credit card. 4.9 ★ from 500+ hotels.
  </p>

  {/* The scan card floats over a bold abstract-art panel (Granola-style framing) */}
  <div class="relative isolate mt-12 max-w-[936px] mx-auto" data-reveal>
    <div
      aria-hidden="true"
      data-parallax="16"
      class="pointer-events-none absolute inset-0 rounded-[24px] art-breathe"
      style="background-image: url('/images/abstract-burst.svg'); background-size: cover; background-position: center; z-index: 0;"
    ></div>
    <div class="relative z-10 p-4 sm:p-6">
      <HeroDemo client:load />
    </div>
  </div>

  <SourcesStrip />
</section>
