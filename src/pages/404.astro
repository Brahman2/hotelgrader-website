---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found · hotelgrader" description="That page doesn't exist. The free report card does.">
  <section class="max-w-content mx-auto px-8 py-24 text-center">
        <h1 class="headline text-[36px] sm:text-[52px]" style="text-wrap: balance;">
      This page doesn’t exist. <em>Your grade does.</em>
    </h1>
    <p class="text-[15px] text-ink-60 mt-5 max-w-[460px] mx-auto leading-relaxed">
      The address may have moved or never existed. Everything worth reading is one
      click away.
    </p>
    <div class="flex flex-wrap items-center justify-center gap-3 mt-9">
      <a href="/" class="btn btn--primary">
        <span>Grade a hotel</span>
      </a>
      <a href="/methodology" class="btn">How the grade is built</a>
    </div>
      </section>
</BaseLayout>
