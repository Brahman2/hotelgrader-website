---
import BaseLayout from '../layouts/BaseLayout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Contours from '../components/Contours.astro';
import HeroForm from '../components/HeroForm.tsx';
import { gradeUrl } from '../lib/hg';

// The whole homepage: a name, a search box, one example, and a contour field
// behind it that rises under the cursor.
// Ten independent hotels (7 US, 2 Europe, 1 Asia). One is picked at random per visit.
const examples = [
  ['Chateau Marmont', 'Los Angeles', 'CA'],
  ['The Bowery Hotel', 'New York', 'NY'],
  ['Hotel Emma', 'San Antonio', 'TX'],
  ['Post Ranch Inn', 'Big Sur', 'CA'],
  ['The Dewberry Charleston', 'Charleston', 'SC'],
  ['Faena Hotel Miami Beach', 'Miami Beach', 'FL'],
  ['Surfjack Hotel & Swim Club', 'Honolulu', 'HI'],
  ['Hôtel Costes', 'Paris', 'France'],
  ['Hotel Il Pellicano', 'Porto Ercole', 'Italy'],
  ['The Siam', 'Bangkok', 'Thailand'],
].map(([hotel, city, region]) => ({ label: `${hotel}, ${city}`, href: gradeUrl(hotel, city, region) }));
---

<BaseLayout showHeader={false}>
  <Contours />
  <!-- z-10: the hero section below is positioned and would otherwise sit on top of this button. -->
  <div class="absolute top-4 right-5 z-10"><ThemeToggle /></div>
  <section class="relative min-h-[calc(100dvh-70px)] flex flex-col items-center justify-center px-5 pb-[12vh] text-center">
    <h1 class="headline text-[40px] sm:text-[64px] flex items-center justify-center gap-3 sm:gap-4">
      <img src="/assets/favicon.svg" alt="" width="52" height="52" class="light-only w-[34px] h-[34px] sm:w-[52px] sm:h-[52px] rounded-[8px] sm:rounded-[12px]" />
      <span>hotelgrader<span class="caret dark-only" aria-hidden="true"></span></span>
      <span class="chip self-start mt-2 sm:mt-3">beta</span>
    </h1>

    <div class="w-full max-w-[600px] mt-10">
      <HeroForm client:load autoFocus />
    </div>

    <p class="text-ink-60 mt-6 max-w-[520px]">
      Type a hotel. Get a free report card on the marketing behind its occupancy and ADR.
    </p>
    <p class="meta mt-3">
      Try it with <a id="example" href={examples[0].href}>{examples[0].label}</a>
    </p>
    <script is:inline define:vars={{ examples }}>
      (function () {
        var pick = examples[Math.floor(Math.random() * examples.length)];
        var a = document.getElementById('example');
        if (a && pick) { a.href = pick.href; a.textContent = pick.label; }
      })();
    </script>
  </section>
</BaseLayout>
