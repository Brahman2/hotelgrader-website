---
import HeroForm from './HeroForm.tsx';
import HeroDemo from './HeroDemo.tsx';
import SourcesStrip from './SourcesStrip.astro';
---

<section class="px-6 sm:px-8 pt-14 sm:pt-20 pb-12 max-w-content mx-auto">
  <h1 class="headline text-[44px] sm:text-[66px] lg:text-[80px] max-w-[15ch]">
    Your hotel has a grade. <em>You just haven’t seen it.</em>
  </h1>

  {/* One tight sans line — not a second serif block — keeps the head from reading text-heavy */}
  <p class="mt-5 text-[17px] sm:text-[19px] text-ink-60 leading-relaxed max-w-[540px]">
    A 46-metric read on how your property shows up online — AI engines, search,
    reviews, ads, booking — scored against your comp set in thirty seconds.
  </p>

  <div class="max-w-[600px] mt-7">
    <HeroForm client:load align="left" />
    <p class="text-[12px] text-ink-40 mt-3 tabular">
      Free. No credit card. 4.9 ★ from 500+ hotels. 30-second analysis.
    </p>
  </div>

  <HeroDemo client:load />

  <SourcesStrip />
</section>
